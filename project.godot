; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game2DProject"
run/main_scene="res://scenes/ui/TitleScreen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

SaveManager="*uid://dtnjfa2plofur"
SceneTransition="*uid://um4ro0bix7p4"
AudioManager="*uid://dvhh8xf5ix8e3"
DialogManager="res://scenes/systems/DialogManager.tscn"
ConfigManager="*res://scripts/systems/config_manager.gd"
LocaleManager="*res://scripts/systems/locale_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

